		function(
			TextChatMessage
		)

			local TextSource =
				TextChatMessage.TextSource

			-- System messages don't belong
			-- to a player's head.
			if not TextSource then
				return
			end

			local Player =
				Players:GetPlayerByUserId(
					TextSource.UserId
				)

			if not Player then
				return
			end

			local Character =
				Player.Character

			if not Character then
				return
			end

			local Adornee =
				Character:FindFirstChild(
					"Head"
				)

			if not Adornee then

				Adornee =
					Character:FindFirstChild(
						"HumanoidRootPart"
					)

			end

			if not Adornee then

				Adornee =
					Character

			end

			if not Adornee then
				return
			end

			local Message =
				TextChatMessage.Text

			if
				not Message
				or Message == ""
			then
				return
			end

			createBubble(
				Adornee,
				Message,
				Player == LocalPlayer
			)

		end
	)

	--============================================================*
	-- BUBBLE DISTANCE / VISIBILITY
	--============================================================*

	task.spawn(function()

		while true do

			task.wait()

			Camera =
				workspace.CurrentCamera

			if not Camera then
				continue
			end

			for Adornee, Queue in pairs(
				ChatBubbleQueues
			) do

				if
					not Adornee
					or not Adornee.Parent
				then

					ChatBubbleQueues[
						Adornee
					] = nil

					continue

				end

				if #Queue == 0 then
					continue
				end

				local MostRecentChatBubble =
					Queue[1]

				if
					not MostRecentChatBubble
					or not MostRecentChatBubble.Parent
				then

					continue

				end

				local DistanceFromAdornee

				pcall(function()

					DistanceFromAdornee =
						(
							Camera.CFrame.Position
							-
							Adornee:GetPivot().Position
						).Magnitude

				end)

				if not DistanceFromAdornee then
					continue
				end

				for Index, BubbleGui in ipairs(
					Queue
				) do

					if not BubbleGui.Parent then
						continue
					end

					local BillboardFrame =
						BubbleGui:FindFirstChild(
							"BillboardFrame"
						)

					if not BillboardFrame then
						continue
					end

					local MainBubble =
						BillboardFrame:FindFirstChild(
							"ChatBubble"
						)

					local SmallBubble =
						BillboardFrame:FindFirstChild(
							"SmallTalkBubble"
						)

					local MainTail =
						BillboardFrame:FindFirstChild(
							"ChatBubbleTail"
						)

					if
						DistanceFromAdornee
						< NEAR_BUBBLE_DISTANCE
					then

						--================================================*
						-- NEAR
						--================================================*

						if Index == 1 then

							if MainBubble then
								MainBubble.Visible = true
							end

							if MainTail then
								MainTail.Visible = true
							end

						else

							if MainBubble then
								MainBubble.Visible = true
							end

							if MainTail then
								MainTail.Visible = false
							end

						end

						if SmallBubble then
							SmallBubble.Visible = false
						end

						BubbleGui.Enabled =
							true

					elseif
						DistanceFromAdornee
						< MAX_BUBBLE_DISTANCE
						and Index == 1
					then

						--================================================*
						-- MEDIUM DISTANCE
						--================================================*

						if MainBubble then
							MainBubble.Visible = false
						end

						if MainTail then
							MainTail.Visible = false
						end

						if SmallBubble then
							SmallBubble.Visible = true
						end

						BubbleGui.Enabled =
							true

					else

						--================================================*
						-- FAR
						--================================================*

						BubbleGui.Enabled =
							false

					end

				end

			end

		end

	end)

end)

Run(Settings.HideDisplayName, function()

	-- Functions

	local Change = function(Player)

		local Character =
			(
				Player.Character
				or Player.CharacterAdded:Wait()
			)

		local Humanoid =
			(
				Character
				and Character:FindFirstChildOfClass(
					"Humanoid"
				)
			)

		if
			(Humanoid
			and Humanoid.DisplayName
			== Player.DisplayName)
		then

			Humanoid.DisplayName =
				Player.Name

		else

			Character.ChildAdded:Connect(
				function(Humanoid)

					if
						(Humanoid:IsA("Humanoid")
						and Humanoid.DisplayName
						== Player.DisplayName)
					then

						Humanoid.DisplayName =
							Player.Name

					end

				end
			)

		end

	end

	local Joined = function(Player)

		Change(Player)

		Player.CharacterAdded:Connect(
			function()
				Change(Player)
			end
		)

	end

	-- Setup

	for _, Player in next,
		Players:GetPlayers()
	do

		task.spawn(
			Joined,
			Player
		)

	end

	Players.PlayerAdded:Connect(
		Joined
	)

end)

