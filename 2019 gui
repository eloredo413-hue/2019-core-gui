	-- MESSAGE LENGTH
	--============================================================*

	local function getMessageLength(Message)

		local Success, Length =
			pcall(
				function()

					return
						utf8.len(
							utf8.nfcnormalize(
								Message
							)
						)

				end
			)

		if Success and Length then
			return Length
		end

		return #Message

	end

	--============================================================*
	-- SANITIZE MESSAGE
	--============================================================*

	local function sanitizeChatLine(Message)

		local Length =
			getMessageLength(
				Message
			)

		if
			Length
			<= MAX_CHAT_MESSAGE_LENGTH_EXCLUSIVE
		then

			return Message

		end

		local ByteOffset

		pcall(function()

			ByteOffset =
				utf8.offset(
					Message,
					MAX_CHAT_MESSAGE_LENGTH_EXCLUSIVE
					+ getMessageLength(
						ELLIPSES
					)
					+ 1
				)

		end)

		if not ByteOffset then
			return string.sub(
				Message,
				1,
				MAX_CHAT_MESSAGE_LENGTH_EXCLUSIVE
			)
		end

		return
			string.sub(
				Message,
				1,
				ByteOffset - 1
			)

	end

	--============================================================*
	-- LIFETIME
	--============================================================*

	local function lerpLength(
		Message,
		Minimum,
		Maximum
	)

		local Alpha =
			math.min(
				getMessageLength(
					Message
				) / 75,
				1
			)

		return
			Minimum
			+ (
				Maximum - Minimum
			)
			* Alpha

