							TextStrokeTransparency = 1
						}
					):Play()

				end)

			--================================================*
			-- IMAGES
			--================================================*

			elseif
				Object:IsA("ImageLabel")
				or Object:IsA("ImageButton")
			then

				pcall(function()

					TweenService:Create(
						Object,
						FadeInfo,
						{
							ImageTransparency = 1
						}
