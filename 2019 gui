--[[
	2019 ESCAPE MENU ONLY

	Keeps the modern Roblox UI (top bar, chat, player list, backpack)
	and swaps in only the 2019 escape menu:

	  * clicking the normal Roblox icon in the top-left opens / closes
	    the 2019 menu instead of the modern one
	  * the Escape key opens / closes the 2019 menu

	Everything else the Legacy model creates is hidden.
]]

if (not game:IsLoaded()) then
	game.Loaded:Wait()
end

-- Settings

local Environment = (getgenv or function() return _G end)

local Settings = Environment().LegacySettings or ({
	Year = 2017,

	SafeChat = true,
})

-- Services

local CoreGui = game:GetService("CoreGui")

local StarterGui = game:GetService("StarterGui")

local GuiService = game:GetService("GuiService")

-- Variables

local RobloxGui = CoreGui:WaitForChild("RobloxGui", 30) or CoreGui:FindFirstChild("RobloxGui")

-- Remember what the modern UI looks like before Legacy touches it,
-- so it can be put back afterwards.

local CoreGuiTypes = {
	Enum.CoreGuiType.PlayerList,
	Enum.CoreGuiType.Health,
	Enum.CoreGuiType.Backpack,
	Enum.CoreGuiType.Chat,
	Enum.CoreGuiType.EmotesMenu,
}

local CoreGuiState = {}

for _, Type in ipairs(CoreGuiTypes) do
	local Success, Enabled = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, Type)
	if Success then
		CoreGuiState[Type] = Enabled
	end
end

local ModernScreenGuis = {}

for _, Name in ipairs({ "TopBarApp", "ExperienceChat" }) do
	local Gui = CoreGui:FindFirstChild(Name)
	if Gui then
		if Gui:IsA("ScreenGui") then
			ModernScreenGuis[Gui] = Gui.Enabled
		end
		for _, Object in ipairs(Gui:GetDescendants()) do
			if Object:IsA("ScreenGui") then
				ModernScreenGuis[Object] = Object.Enabled
			end
		end
	end
end

-- Everything that exists before Legacy loads belongs to the modern UI.
-- Anything that shows up while it loads is the 2019 GUI.

local GuiRoots = { CoreGui, RobloxGui }

if gethui then
	local Success, Hidden = pcall(gethui)
	if Success and typeof(Hidden) == "Instance" and Hidden ~= CoreGui then
		table.insert(GuiRoots, Hidden)
	end
end

local Existing = {}

for _, Root in ipairs(GuiRoots) do
	for _, Child in ipairs(Root:GetChildren()) do
		Existing[Child] = true
	end
end

local Created = {}

local Watching = true

local Watchers = {}

for _, Root in ipairs(GuiRoots) do
	table.insert(Watchers, Root.ChildAdded:Connect(function(Child)
		if Watching then
			table.insert(Created, Child)
		end
	end))
end

-- Module

local Suite = Environment().Suite or loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/yeku/forks/refs/heads/main/Scripts/RBXMSuite.luau"
))()

local Legacy = Suite.launch(
	Suite.download(
		"Elite-random/test@idk",
		"Legacy_2019.rbxm"
	),
	{
		runscripts = true,
		debug = true,
		verbose = false
	}
)

-- Setup

local LegacyGui =
	Suite.require(Legacy):Start(
		Settings.Year,
		Settings.SafeChat
	)

-- The settings hub module the Legacy GUI already loaded. Suite caches
-- required modules, so this is the same hub that is on screen.

local SettingsHub = (function()

	local Module

	for _, Object in ipairs(Legacy:GetDescendants()) do
		if Object.Name == "SettingsHub" and Object:IsA("ModuleScript") then
			Module = Object
			break
		end
	end

	if not Module then
		warn("[2019 menu] SettingsHub module not found")
		return nil
	end

	local Success, Result = pcall(Suite.require, Module)

	if not Success then
		warn("[2019 menu] SettingsHub could not be loaded:", Result)
		return nil
	end

	return Result

end)()

--============================================================*
-- HIDE EVERYTHING EXCEPT THE MENU
--============================================================*

-- Things the 2019 GUI made, outside the menu: top bar, chat, player
-- list, backpack, loading screen and so on.

local IsNew = function(Object)
	return not Existing[Object]
		and Object.Name ~= "Legacy2019MenuIcon"
		and Object ~= Legacy
end

local NewRoots = function()

	local Roots = {}

	for _, Root in ipairs(GuiRoots) do
		for _, Child in ipairs(Root:GetChildren()) do
			if IsNew(Child) then
				table.insert(Roots, Child)
			end
		end
	end

	if
		typeof(LegacyGui) == "Instance"
		and IsNew(LegacyGui)
		and not table.find(GuiRoots, LegacyGui)
		and not table.find(Roots, LegacyGui)
	then
		table.insert(Roots, LegacyGui)
	end

	return Roots

end

-- The 2019 menu frame. Only one made by Legacy counts; the modern
-- RobloxGui has a frame with the same name.

local FindMenu = function()

	if SettingsHub and typeof(SettingsHub.ClippingShield) == "Instance" then
		return SettingsHub.ClippingShield
	end

	for _, Root in ipairs(NewRoots()) do

		if Root.Name == "SettingsClippingShield" then
			return Root
		end

		local Found = Root:FindFirstChild("SettingsClippingShield", true)

		if Found then
			return Found
		end

	end

	return nil

end

local Menu

do
	local StartTime = os.clock()

	repeat
		Menu = FindMenu()
		if not Menu then
			task.wait(0.1)
		end
	until Menu or os.clock() - StartTime > 10

	if not Menu then
		warn("[2019 menu] the 2019 menu frame was not found; hiding all of the 2019 GUI")
	end
end

local Lock = function(Object, Property, Value)

	pcall(function()
		Object[Property] = Value
	end)

	Object:GetPropertyChangedSignal(Property):Connect(function()
		if Object[Property] ~= Value then
			Object[Property] = Value
		end
	end)

end

local Handled = {}

local Hide

Hide = function(Object)

	if Handled[Object] or Object.Name == "Legacy2019MenuIcon" then
		return
	end

	Handled[Object] = true

	-- The menu and everything in it stays as it is.
	if Menu and (Object == Menu or Object:IsDescendantOf(Menu)) then
		return
	end

	-- A frame or screen that holds the menu stays visible, but its
	-- other children are hidden.
	if Menu and Menu:IsDescendantOf(Object) then

		for _, Child in ipairs(Object:GetChildren()) do
			Hide(Child)
		end

		Object.ChildAdded:Connect(Hide)

		return

	end

	if Object:IsA("LayerCollector") then

		Lock(Object, "Enabled", false)

	elseif Object:IsA("GuiObject") then

		Lock(Object, "Visible", false)

	elseif Object:IsA("Folder") or Object:IsA("Configuration") then

		for _, Child in ipairs(Object:GetChildren()) do
			Hide(Child)
		end

		Object.ChildAdded:Connect(Hide)

	end

end

for _, Root in ipairs(NewRoots()) do
	Hide(Root)
end

-- Keep catching 2019 pieces that appear shortly after start-up,
-- then stop so later modern prompts are left alone.

for _, Child in ipairs(Created) do
	if Child.Parent and IsNew(Child) then
		Hide(Child)
	end
end

task.delay(5, function()
	Watching = false
	for _, Watcher in ipairs(Watchers) do
		Watcher:Disconnect()
	end
end)

for _, Root in ipairs(GuiRoots) do
	local Connection
	Connection = Root.ChildAdded:Connect(function(Child)
		if Watching then
			Hide(Child)
		else
			Connection:Disconnect()
		end
	end)
end

--============================================================*
-- RESTORE THE MODERN UI
--============================================================*

local Restore = function()

	pcall(function()
		RobloxGui.Enabled = true
	end)

	for Type, Enabled in pairs(CoreGuiState) do
		pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Type, Enabled)
	end

	for Gui, Enabled in pairs(ModernScreenGuis) do
		if Gui.Parent then
			pcall(function()
				Gui.Enabled = Enabled
			end)
		end
	end

end

-- Legacy may switch things off a moment after :Start() returns.

task.spawn(function()
	for _ = 1, 6 do
		Restore()
		task.wait(0.5)
	end
end)

--============================================================*
-- OPEN THE MENU
--============================================================*

local FindShield = function()
	return Menu and Menu:FindFirstChild("SettingsShield", true)
end

local ToggleMenu = function()

	if SettingsHub then

		local Success = pcall(function()
			if SettingsHub.ToggleVisibility then
				SettingsHub:ToggleVisibility()
			else
				SettingsHub:SetVisibility(not SettingsHub.Visible)
			end
		end)

		if Success then
			return
		end

	end

	-- Fallback: show the menu frame directly.
	local Shield = FindShield()

	if Shield then
		Shield.Visible = not Shield.Visible
	end

end

--============================================================*
-- ROBLOX ICON
--============================================================*
--
-- An invisible button sits on top of the modern Roblox icon, so
-- clicking the icon opens the 2019 menu and the modern menu never
-- gets the click.

local FindRobloxIcon = function()

	local TopBarApp = CoreGui:FindFirstChild("TopBarApp")

	if not TopBarApp then
		return nil
	end

	local Best

	for _, Object in ipairs(TopBarApp:GetDescendants()) do

		if
			Object:IsA("GuiObject")
			and Object.Name:lower():find("menuicon")
			and Object.AbsoluteSize.X > 0
			and Object.AbsoluteSize.Y > 0
		then

			-- Prefer the largest visible piece of the icon.
			if
				not Best
				or Object.AbsoluteSize.X * Object.AbsoluteSize.Y
					> Best.AbsoluteSize.X * Best.AbsoluteSize.Y
			then
				Best = Object
			end

		end

	end

	return Best

end

local ProtectGui = (syn and syn.protect_gui) or protectgui

local IconGui = Instance.new("ScreenGui")
IconGui.Name = "Legacy2019MenuIcon"
IconGui.IgnoreGuiInset = true
IconGui.ResetOnSpawn = false
IconGui.DisplayOrder = 2147483647
IconGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

if ProtectGui then
	pcall(ProtectGui, IconGui)
end

local IconButton = Instance.new("TextButton")
IconButton.Name = "RobloxIcon"
IconButton.Text = ""
IconButton.BackgroundTransparency = 1
IconButton.AutoButtonColor = false
IconButton.Selectable = false
-- Used until the real icon is found: the top-left icon slot.
IconButton.Position = UDim2.fromOffset(12, 6)
IconButton.Size = UDim2.fromOffset(44, 44)
IconButton.Parent = IconGui

IconGui.Parent = (gethui and gethui()) or CoreGui

IconButton.Activated:Connect(ToggleMenu)

-- Keep the button lined up with the icon (it moves on resize and
-- when the top bar layout changes).

local RobloxIcon

task.spawn(function()

	while IconGui.Parent do

		if not (RobloxIcon and RobloxIcon:IsDescendantOf(CoreGui)) then
			RobloxIcon = FindRobloxIcon()
		end

		if RobloxIcon then

			local TopBarGui = RobloxIcon:FindFirstAncestorOfClass("ScreenGui")
			local Offset = Vector2.zero

			-- AbsolutePosition is measured below the inset when the
			-- top bar's ScreenGui doesn't ignore it.
			if TopBarGui and not TopBarGui.IgnoreGuiInset then
				Offset = GuiService:GetGuiInset()
			end

			local Position = RobloxIcon.AbsolutePosition + Offset

			IconButton.Position = UDim2.fromOffset(Position.X, Position.Y)
			IconButton.Size = UDim2.fromOffset(RobloxIcon.AbsoluteSize.X, RobloxIcon.AbsoluteSize.Y)
			IconButton.Visible = RobloxIcon.Visible and TopBarGui ~= nil and TopBarGui.Enabled

		end

		task.wait(0.5)

	end

end)
