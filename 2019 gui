--[[
	2019 ESCAPE MENU ONLY

	Keeps the modern Roblox UI exactly as it is and adds only the
	2019 escape menu from the Legacy model:

	  * tapping / clicking the normal Roblox icon in the top-left
	    opens and closes the 2019 menu instead of the modern one
	  * the phone's back button and Escape open it too (the modern
	    menu they would open is closed again straight away)
	  * while it is open, the Roblox icon shows as a white X that
	    closes it

	Only the menu module is loaded. The 2019 top bar, chat, player
	list, backpack and loading screen are never created.
]]

if (not game:IsLoaded()) then
	game.Loaded:Wait()
end

-- Settings

local Environment = (getgenv or function() return _G end)

local Settings = Environment().LegacySettings or ({
	Year = 2017,
})

-- Services

local CoreGui = game:GetService("CoreGui")

local ContextActionService = game:GetService("ContextActionService")

-- Constants

-- The menu's modules look their GUI up as CoreGui.NewRobloxGui.
local GUI_NAME = "NewRobloxGui"

local BUTTON_NAME = "Legacy2019MenuButton"

-- Stop a previous run of this script first, so two menus never
-- fight over the Roblox icon.

local Previous = Environment().Legacy2019Menu

if type(Previous) == "table" and type(Previous.Stop) == "function" then
	pcall(Previous.Stop)
end

local Running = true

local Connections = {}

-- Functions

local Lock = function(Object, Property, Value)

	pcall(function()
		Object[Property] = Value
	end)

	table.insert(Connections, Object:GetPropertyChangedSignal(Property):Connect(function()
		if Object[Property] ~= Value then
			Object[Property] = Value
		end
	end))

end

-- Module

local Suite = Environment().Suite or loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/yeku/forks/refs/heads/main/Scripts/RBXMSuite.luau"
))()

-- Load the model without running any of its scripts.

local Legacy = Suite.launch(
	Suite.download(
		"Elite-random/test@idk",
		"Legacy_2019.rbxm"
	),
	{
		runscripts = false,
		debug = true,
	}
)

--============================================================*
-- FIND THE MENU
--============================================================*
--
-- Legacy/Core/<Year>/NewRobloxGui/Modules/Settings/SettingsHub

local HasMenu = function(Folder)
	local Gui = Folder:FindFirstChild(GUI_NAME)
	local Modules = Gui and Gui:FindFirstChild("Modules")
	local SettingsFolder = Modules and Modules:FindFirstChild("Settings")
	return SettingsFolder ~= nil and SettingsFolder:FindFirstChild("SettingsHub") ~= nil
end

local Client = (function()

	local Core = Legacy:FindFirstChild("Core")

	if not Core then
		return nil
	end

	for _, Year in ipairs({ tostring(Settings.Year), "2017" }) do
		local Folder = Core:FindFirstChild(Year)
		if Folder and HasMenu(Folder) then
			return Folder
		end
	end

	-- Otherwise the newest year that has the menu.
	local Best

	for _, Folder in ipairs(Core:GetChildren()) do
		if
			HasMenu(Folder)
			and (not Best or (tonumber(Folder.Name) or 0) > (tonumber(Best.Name) or 0))
		then
			Best = Folder
		end
	end

	return Best

end)()

if not Client then
	warn("[2019 menu] no escape menu found in the Legacy model")
	return
end

local LegacyGui = Client:FindFirstChild(GUI_NAME)

local Modules = LegacyGui.Modules

local SettingsHubModule = Modules.Settings.SettingsHub

--============================================================*
-- WHAT THE MENU NEEDS
--============================================================*

-- A few values in Lighting and modules in ReplicatedStorage
-- (the same thing Legacy:CreateUtilities() does).

local Utility = Legacy:FindFirstChild("Utility")

if Utility then

	for _, ServiceFolder in ipairs(Utility:GetChildren()) do

		local Success, Service = pcall(game.GetService, game, ServiceFolder.Name)

		if Success and Service then
			for _, Object in ipairs(ServiceFolder:GetChildren()) do
				Object.Parent = Service
			end
		end

	end

end

-- The menu calls into the 2019 chat, player list and backpack. Give
-- it stand-ins so those are never loaded: they would build their own
-- windows and take over chat and hotbar keys from the modern UI.

local SuiteModules = getgenv and getgenv().__rbxm_suite_modules

local NoOp = function() end

local StandIn = function(Members)
	return setmetatable(Members, {
		__index = function()
			return NoOp
		end,
	})
end

local Replace = function(Name, Value)

	local Module = Modules:FindFirstChild(Name)

	if not Module then
		return
	end

	local Record = SuiteModules and SuiteModules[Module]

	if Record then
		Record.data = Value
		Record.isLoaded = true
	else
		warn("[2019 menu] could not replace the 2019 " .. Name .. "; it may show up")
	end

end

Replace("Chat", StandIn({
	GetVisibility = function()
		return false
	end,
}))

Replace("PlayerlistModule", StandIn({}))

Replace("BackpackScript", StandIn({
	IsOpen = false,
}))

--============================================================*
-- INSTALL THE GUI
--============================================================*

-- The model ships a few loose frames (zoom buttons, a backdrop) that
-- are not part of the menu. Everything the menu creates is added
-- later and left alone.

for _, Child in ipairs(LegacyGui:GetChildren()) do
	if Child:IsA("GuiObject") then
		Lock(Child, "Visible", false)
	end
end

-- A NewRobloxGui left over from an older Legacy script would be found
-- first by name. Move it out of the way.

for _, Child in ipairs(CoreGui:GetChildren()) do
	if Child.Name == GUI_NAME then
		warn("[2019 menu] an older Legacy GUI is still running; rejoin for a clean start")
		Child.Name = GUI_NAME .. "Old"
		if Child:IsA("ScreenGui") then
			pcall(function()
				Child.Enabled = false
			end)
		end
	end
end

LegacyGui.ResetOnSpawn = false

-- Above the modern UI while the menu is open.
LegacyGui.DisplayOrder = 100000

LegacyGui.Parent = CoreGui

--============================================================*
-- LOAD THE MENU
--============================================================*

local Loaded, Hub = pcall(Suite.require, SettingsHubModule)

if not Loaded or type(Hub) ~= "table" then
	warn("[2019 menu] the 2019 escape menu failed to load:", Hub)
	LegacyGui:Destroy()
	return
end

-- The menu binds F9 to the dev console; Roblox already does that.
pcall(ContextActionService.UnbindAction, ContextActionService, "Open Dev Console")

-- Dropdown buttons (e.g. "Which Player?" and "Type Of Abuse" on the
-- report tab) turn blue when pressed and stay blue: the menu makes
-- them unselectable while the list is open, which skips the code that
-- turns them grey again. Reset them whenever a list closes.

local GuiService = game:GetService("GuiService")

local DROPDOWN_IMAGE = "rbxasset://textures/ui/Settings/MenuBarAssets/MenuButton.png"

local ResetDropDowns = function()
	for _, Object in ipairs(LegacyGui:GetDescendants()) do
		if
			Object.Name == "DropDownFrameButton"
			and Object:IsA("ImageButton")
			and GuiService.SelectedObject ~= Object
		then
			Object.Image = DROPDOWN_IMAGE
		end
	end
end

local WatchDropDownList = function(Object)
	if Object.Name == "DropDownFullscreenFrame" and Object:IsA("GuiObject") then
		table.insert(Connections, Object:GetPropertyChangedSignal("Visible"):Connect(function()
			if not Object.Visible then
				ResetDropDowns()
			end
		end))
	end
end

for _, Child in ipairs(LegacyGui:GetChildren()) do
	WatchDropDownList(Child)
end

table.insert(Connections, LegacyGui.ChildAdded:Connect(WatchDropDownList))

local ToggleMenu = function()

	local Success, Result = pcall(function()
		if Hub.ToggleVisibility then
			Hub:ToggleVisibility()
		else
			Hub:SetVisibility(not Hub:GetVisibility())
		end
	end)

	if not Success then
		warn("[2019 menu] could not open the menu:", Result)
	end

end

--============================================================*
-- ROBLOX ICON
--============================================================*
--
-- An invisible button is put inside the modern Roblox icon. It sits
-- on top of the icon, so a tap opens the 2019 menu and the modern
-- menu never gets it.

local IsShown = function(Object)

	local Current = Object

	while Current and Current ~= game do

		if Current:IsA("GuiObject") and not Current.Visible then
			return false
		end

		if Current:IsA("LayerCollector") then
			return Current.Enabled
		end

		Current = Current.Parent

	end

	return false

end

local Area = function(Object)
	return Object.AbsoluteSize.X * Object.AbsoluteSize.Y
end

local FindRobloxIcon = function()

	local TopBarApp = CoreGui:FindFirstChild("TopBarApp")

	if not TopBarApp then
		return nil
	end

	local NamedButton, NamedObject, Leftmost

	for _, Object in ipairs(TopBarApp:GetDescendants()) do

		if
			Object:IsA("GuiObject")
			and Object.Name ~= BUTTON_NAME
			and Object.AbsoluteSize.X > 0
			and Object.AbsoluteSize.Y > 0
			and IsShown(Object)
		then

			-- The icon element is named like "MenuIcon".
			local InMenuIcon = false
			local Current = Object

			while Current and Current ~= TopBarApp do
				if Current.Name:lower():find("menuicon") then
					InMenuIcon = true
					break
				end
				Current = Current.Parent
			end

			if InMenuIcon then

				if Object:IsA("GuiButton") then
					if not NamedButton or Area(Object) > Area(NamedButton) then
						NamedButton = Object
					end
				elseif not NamedObject or Area(Object) > Area(NamedObject) then
					NamedObject = Object
				end

			elseif Object:IsA("GuiButton") then

				-- Otherwise: the leftmost icon-sized button in the top bar.
				local Size = Object.AbsoluteSize

				if
					Size.X >= 16 and Size.X <= 100
					and Size.Y >= 16 and Size.Y <= 100
					and (not Leftmost or Object.AbsolutePosition.X < Leftmost.AbsolutePosition.X)
				then
					Leftmost = Object
				end

			end

		end

	end

	return NamedButton or NamedObject or Leftmost

end

local Button = Instance.new("TextButton")
Button.Name = BUTTON_NAME
Button.Text = ""
Button.BackgroundTransparency = 1
Button.AutoButtonColor = false
Button.Selectable = false
Button.Position = UDim2.fromScale(0, 0)
Button.Size = UDim2.fromScale(1, 1)
Button.ZIndex = 1000

table.insert(Connections, Button.Activated:Connect(ToggleMenu))

-- The top bar can rebuild the icon (rotation, resize), so keep
-- checking that the button is still on it.

task.spawn(function()

	local StartTime = os.clock()

	local Warned = false

	while Running do

		local Parent = Button.Parent

		if not (Parent and Parent:IsDescendantOf(CoreGui) and IsShown(Parent)) then

			local Icon = FindRobloxIcon()

			if Icon then
				Button.Parent = Icon
			elseif not Warned and os.clock() - StartTime > 15 then
				Warned = true
				warn("[2019 menu] could not find the Roblox icon in the top bar")
			end

		end

		task.wait(0.5)

	end

end)

--============================================================*
-- BACK BUTTON / ESCAPE
--============================================================*
--
-- The phone's back button (and Escape on PC) opens the modern menu
-- directly. When its frame appears, hide it, close it again with an
-- Escape key press, and use the 2019 menu instead: open it, or go
-- back a page / close it if it is already open.

local GuiService = game:GetService("GuiService")

local VirtualInputManager = (function()
	local Success, Service = pcall(game.GetService, game, "VirtualInputManager")
	return Success and Service or nil
end)()

local IsOpen = function()
	local Success, Visible = pcall(function()
		return Hub:GetVisibility()
	end)
	return Success and Visible == true
end

-- Escape now reaches the 2019 menu through the modern one, so its own
-- Escape binding would toggle it twice.
pcall(ContextActionService.UnbindAction, ContextActionService, "RBXEscapeMainMenu")

local GoBack = function()

	local HubObject = Hub.Instance

	if IsOpen() and type(HubObject) == "table" and HubObject.PopMenu then
		pcall(function()
			HubObject:PopMenu(false, true)
		end)
	else
		ToggleMenu()
	end

end

task.spawn(function()

	local RobloxGui = CoreGui:WaitForChild("RobloxGui", 30)
	local Clipping = RobloxGui and RobloxGui:WaitForChild("SettingsClippingShield", 30)
	local Shield = Clipping and Clipping:WaitForChild("SettingsShield", 30)

	if not (Running and Shield) then
		if Running then
			warn("[2019 menu] modern menu not found; the back button may still open it")
		end
		return
	end

	local Closing = false

	local Restore = function()
		Closing = false
		pcall(function()
			Clipping.Visible = true
		end)
	end

	table.insert(Connections, Shield:GetPropertyChangedSignal("Visible"):Connect(function()

		if not Shield.Visible then
			if Closing then
				Restore()
			end
			return
		end

		if Closing or not Running then
			return
		end

		Closing = true

		-- Never show it.
		pcall(function()
			Clipping.Visible = false
		end)

		GoBack()

		-- Close it the way Escape does, once it has finished opening.
		task.defer(function()
			if VirtualInputManager then
				pcall(function()
					VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
					VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
				end)
			end
		end)

		-- Still open: try the back button's own signal.
		task.delay(0.3, function()
			if Closing and Shield.Visible and firesignal then
				pcall(firesignal, GuiService.ShowLeaveConfirmation)
			end
		end)

		-- Still open after that: give it back so the player can close it.
		task.delay(1, function()
			if Closing and Shield.Visible then
				Restore()
				warn("[2019 menu] could not close the modern menu")
			end
		end)

	end))

end)

--============================================================*
-- CLOSE BUTTON
--============================================================*
--
-- While the 2019 menu is open it covers the top bar, so a white X is
-- drawn above it, exactly over the Roblox icon. Tapping it closes the
-- menu, like the 2023 top bar.

local RunService = game:GetService("RunService")

local CloseGui = Instance.new("ScreenGui")
CloseGui.Name = "Legacy2019MenuClose"
CloseGui.IgnoreGuiInset = true
CloseGui.ResetOnSpawn = false
CloseGui.DisplayOrder = LegacyGui.DisplayOrder + 1
CloseGui.Parent = CoreGui

-- A full-screen frame at (0, 0). Its AbsolutePosition turns the icon's
-- on-screen position into a position inside this GUI.
local Origin = Instance.new("Frame")
Origin.Name = "Origin"
Origin.BackgroundTransparency = 1
Origin.Size = UDim2.fromScale(1, 1)
Origin.Parent = CloseGui

local CloseButton = Instance.new("TextButton")
CloseButton.Name = "Close"
CloseButton.Text = ""
CloseButton.AutoButtonColor = false
CloseButton.BackgroundColor3 = Color3.new(1, 1, 1)
CloseButton.BorderSizePixel = 0
CloseButton.Visible = false
CloseButton.Parent = CloseGui

local CLOSE_CORNER = UDim.new(0.18, 0)

local CloseCorner = Instance.new("UICorner")
CloseCorner.CornerRadius = CLOSE_CORNER
CloseCorner.Parent = CloseButton

for _, Angle in ipairs({ 45, -45 }) do

	local Stroke = Instance.new("Frame")
	Stroke.Name = "Stroke"
	Stroke.AnchorPoint = Vector2.new(0.5, 0.5)
	Stroke.Position = UDim2.fromScale(0.5, 0.5)
	Stroke.Size = UDim2.fromScale(0.55, 0.07)
	Stroke.Rotation = Angle
	Stroke.BackgroundColor3 = Color3.fromRGB(57, 59, 61)
	Stroke.BorderSizePixel = 0
	Stroke.Parent = CloseButton

	local Round = Instance.new("UICorner")
	Round.CornerRadius = UDim.new(1, 0)
	Round.Parent = Stroke

end

table.insert(Connections, CloseButton.Activated:Connect(function()
	pcall(function()
		Hub:SetVisibility(false)
	end)
end))

table.insert(Connections, RunService.RenderStepped:Connect(function()

	local Icon = Button.Parent

	if not (IsOpen() and Icon and Icon:IsA("GuiObject") and Icon:IsDescendantOf(CoreGui)) then
		CloseButton.Visible = false
		return
	end

	local Offset = Origin.AbsolutePosition

	CloseButton.Position = UDim2.fromOffset(
		Icon.AbsolutePosition.X - Offset.X,
		Icon.AbsolutePosition.Y - Offset.Y
	)

	CloseButton.Size = UDim2.fromOffset(Icon.AbsoluteSize.X, Icon.AbsoluteSize.Y)

	-- Match the icon's shape (round on the newest top bar).
	local IconCorner = Icon:FindFirstChildOfClass("UICorner")
	CloseCorner.CornerRadius = IconCorner and IconCorner.CornerRadius or CLOSE_CORNER

	CloseButton.Visible = true

end))

--============================================================*
-- CLEAN-UP FOR THE NEXT RUN
--============================================================*

Environment().Legacy2019Menu = {
	Stop = function()

		Running = false

		for _, Connection in ipairs(Connections) do
			Connection:Disconnect()
		end

		pcall(function()
			Hub:SetVisibility(false, true)
		end)

		pcall(ContextActionService.UnbindAction, ContextActionService, "RBXEscapeMainMenu")

		Button:Destroy()

		CloseGui:Destroy()

		LegacyGui:Destroy()

	end,
}
